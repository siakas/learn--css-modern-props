---
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from '../components/ui/card'
import articlesData from '../data/articles.json'
import BaseLayout from '../layouts/BaseLayout.astro'

const { articles } = articlesData
---

<BaseLayout title="モダン CSS の学習" showBackIndex={false}>
  <!-- ページヘッダー -->
  <div class="not-prose mb-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">
      Learning Notes
    </p>
    <h1 class="text-3xl font-bold tracking-tight text-foreground mb-3">
      モダン CSS の学習
    </h1>
    <p class="text-muted-foreground leading-relaxed">
      今はこう書けますよ — IE 対応が不要になった現代の CSS をまとめたノートです。
    </p>
  </div>

  <!-- 記事一覧 -->
  <ul class="not-prose grid grid-cols-2 gap-4 p-0 list-none xl:grid-cols-3">
    {
      articles.map((article, index) => (
        <li class="flex">
          <a
            href={`/articles/${article.slug}`}
            class="group block w-full no-underline"
          >
            <Card className="h-full transition-colors hover:border-primary">
              <CardHeader className="p-5">
                <p class="text-xs font-mono text-muted-foreground mb-2">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <CardTitle className="text-sm font-semibold leading-snug text-foreground group-hover:text-primary transition-colors">
                  {article.title}
                </CardTitle>
                <CardDescription className="text-xs leading-relaxed mt-1">
                  {article.description}
                </CardDescription>
              </CardHeader>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
