---
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from '../components/ui/card'
import articlesData from '../data/articles.json'
import BaseLayout from '../layouts/BaseLayout.astro'

const { articles } = articlesData
---

<BaseLayout title="モダン CSS の学習" showBackIndex={false}>
  <h1 class="not-prose text-3xl font-bold leading-snug">
    モダン CSS の学習 〜今はこう書けますよ〜
  </h1>

  <ul class="not-prose mt-8 flex flex-wrap gap-6 p-0 list-none">
    {
      articles.map((article) => (
        <li class="flex w-[calc(50%-12px)]">
          <a href={`/articles/${article.slug}`} class="block w-full no-underline text-inherit">
            <Card className="h-full transition-colors hover:border-teal-600">
              <CardHeader>
                <CardTitle className="text-teal-600 text-base">
                  {article.title}
                </CardTitle>
                <CardDescription className="text-sm leading-relaxed">
                  {article.description}
                </CardDescription>
              </CardHeader>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
