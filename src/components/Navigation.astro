---
import articlesData from '../data/articles.json'

const { articles } = articlesData
const currentPath = Astro.url.pathname
---

<nav>
  <p class="m-0 text-5xl font-bold">
    <a href="/" class="text-teal-600 no-underline hover:no-underline">#</a>
  </p>
  <ul class="mt-6 list-none p-0 text-[0.9375rem] leading-normal space-y-8">
    {
      articles.map((article) => (
        <li>
          <a
            href={`/articles/${article.slug}`}
            class:list={[
              'font-bold no-underline',
              currentPath === `/articles/${article.slug}`
                ? 'text-teal-600'
                : 'text-neutral-600 hover:text-teal-600',
            ]}
          >
            {article.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
