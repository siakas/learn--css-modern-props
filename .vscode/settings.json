{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // VS Code の CSS, SCSS の Lint オフ
  // Stylelint とのバッティング回避
  "css.validate": false,
  "scss.validate": false,

  // Stylelint のフォーマットを実行する拡張子を指定
  "stylelint.validate": ["css", "scss", "postcss"],

  // Stylelint の実行パスを指定（Path 指定がないとローカル環境で Stylelint が動作しない場合がある）
  "stylelint.stylelintPath": "node_modules/stylelint",

  // JSX でも CSS クラスを補完できるように
  "editor.quickSuggestions": {
    "strings": true
  },

  "[json]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  }
}
